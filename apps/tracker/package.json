{
  "name": "@affiliate-tracker/tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Public click, redirect, conversion, and postback tracking service.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/tracking-handoff-regression.test.mjs test/tracking-preview-regression.test.mjs"
  },
  "dependencies": {
    "@affiliate-tracker/config": "workspace:*",
    "@affiliate-tracker/database": "workspace:*",
    "@affiliate-tracker/observability": "workspace:*",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "tsx": "4.23.1"
  }
}
