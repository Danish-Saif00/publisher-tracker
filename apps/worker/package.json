{
  "name": "@affiliate-tracker/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background job-processing service for the affiliate tracking platform.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@affiliate-tracker/config": "workspace:*",
    "@affiliate-tracker/database": "workspace:*",
    "@affiliate-tracker/observability": "workspace:*",
    "bullmq": "5.53.2"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}
