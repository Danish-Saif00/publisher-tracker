# Application
APP_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Administrative API
API_HOST=127.0.0.1
API_PORT=4000
API_BASE_PATH=/api/v1

# Public tracking service
TRACKER_HOST=127.0.0.1
TRACKER_PORT=4100

# Express security
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
TRACKER_RATE_LIMIT_WINDOW_MS=60000
TRACKER_RATE_LIMIT_MAX_REQUESTS=1000

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
OPENAPI_JSON_PATH=/openapi.json
PUBLIC_APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# PostgreSQL
DATABASE_URL_RUNTIME=postgresql://postgres:replace_me@host:5432/postgres
DATABASE_URL_MIGRATIONS=postgresql://postgres:replace_me@host:5432/postgres
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_QUERY_TIMEOUT_MS=10000

# Redis and queues
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=affiliate-tracker
WORKER_CONCURRENCY=5
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF_MS=1000

# Internal service authentication
INTERNAL_SERVICE_SIGNING_SECRET=replace_with_at_least_32_random_characters

# Sensitive-data protection
DATA_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key
IP_HASH_SECRET=replace_with_at_least_32_random_characters
VISITOR_ID_SIGNING_SECRET=replace_with_at_least_32_random_characters

# Tracking domains
TRACKING_ROOT_DOMAIN=tracking.example.com
POSTBACK_ROOT_DOMAIN=postback.example.com
TRACKING_COOKIE_NAME=affiliate_visitor_id
TRACKING_COOKIE_MAX_AGE_DAYS=365

# Platform email fallback
BREVO_API_KEY=replace_me
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Publisher Tracker
